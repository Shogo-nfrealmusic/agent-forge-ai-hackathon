# Weather Booking Adjustment Agent — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# NEVER commit real keys. NEVER prefix any of these with NEXT_PUBLIC_
# (that would inline the value into the browser bundle).
#
# With no AI_API_KEY the app runs fully offline on the mock AI adapter,
# which is the intended demo default.

# ---- AI provider (OpenAI-compatible /chat/completions) ----------------
# Server-side only. Leave empty to use the mock adapter.
AI_API_KEY=

# Qwen Cloud (DashScope international, OpenAI-compatible mode):
#   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# OpenAI:
#   https://api.openai.com/v1
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# qwen-plus / qwen-max / gpt-4o-mini / ...
AI_MODEL=qwen-plus

# ---- Weather ----------------------------------------------------------
# Open-Meteo needs no key. Set to "false" to force the fixture path
# (useful for an offline demo).
WEATHER_USE_LIVE=true

# ---- Audit log --------------------------------------------------------
# Local JSONL file. Defaults to ./.data/audit-log.jsonl
# AUDIT_LOG_PATH=
