# Weather Booking Adjustment Agent — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# NEVER commit real keys. NEVER prefix any of these with NEXT_PUBLIC_
# (that would inline the value into the browser bundle).
#
# With nothing configured the app runs fully offline: mock AI, fixture weather
# fallback, and delivery limited to hand-off links. That is the demo default.

# ---- AI provider (OpenAI-compatible /chat/completions) ----------------
# Server-side only. Leave empty to use the mock adapter.
AI_API_KEY=

# Qwen Cloud (DashScope international, OpenAI-compatible mode):
#   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# OpenAI:
#   https://api.openai.com/v1
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# qwen-plus / qwen-max / gpt-4o-mini / ...
AI_MODEL=qwen-plus

# ---- AI failover provider: GMI Cloud (OpenAI-compatible) --------------
# https://docs.gmicloud.ai/quickstart
# Tried automatically when Qwen Cloud fails or returns an off-schema payload.
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# ---- Daytona: sandbox for AI-generated code ---------------------------
# https://www.daytona.io/docs
# The model writes a Python ranking function and it runs INSIDE a Daytona
# sandbox — never on this server. Without a key we use our own trusted
# hand-written implementation instead; generated code is never run locally.
DAYTONA_API_KEY=
# Optional region/target override.
DAYTONA_TARGET=
# Demo mode: keep sandboxes after the run so they stay visible in the Daytona
# dashboard (they still auto-stop after a minute). Leave off outside a demo.
DAYTONA_KEEP_SANDBOX=false

# ---- Weather ----------------------------------------------------------
# Open-Meteo needs no key. Set to "false" to force the fixture path
# (useful for an offline demo).
WEATHER_USE_LIVE=true

# ---- Outbound delivery ------------------------------------------------
# MASTER KILL SWITCH. Unless this is exactly "true", provider calls are
# simulated and NO message is ever delivered. Keep it false for demos.
DELIVERY_ALLOW_REAL_SEND=false

# WhatsApp provider: "meta" (WhatsApp Business Cloud API) or "twilio".
# Leave empty to disable provider sending entirely — the UI still offers the
# wa.me hand-off link, which sends from the staff member's own WhatsApp.
WHATSAPP_PROVIDER=

# --- if WHATSAPP_PROVIDER=meta ---
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- if WHATSAPP_PROVIDER=twilio ---
# https://www.twilio.com/docs/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email has no provider adapter by design — the UI produces a mailto: link and
# the staff member sends from their own client. See src/lib/delivery/email.ts.

# ---- Demo destination override ----------------------------------------
# Sends hand-off links and deliveries to YOUR address instead of the booking's
# fictional contact, so you can demo against your own phone.
#
# Put a real number HERE, never in the fixtures: this repository is public and
# a personal phone number committed to git cannot be taken back. Values here
# are masked in the audit log and are never written to any tracked file.
# E.164 format, e.g. +819012345678
DEMO_WHATSAPP_TO=
DEMO_EMAIL_TO=

# ---- Audit log --------------------------------------------------------
# Local JSONL file. Defaults to ./.data/audit-log.jsonl
# AUDIT_LOG_PATH=
